{
  "expo": {
    "name": "피노리",
    "slug": "spotit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spotit/app-icon-1024.png",
    "scheme": "spotit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "icon": "./assets/spotit/app-icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/spotit/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/spotit/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/spotit/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4EE",
          "image": "./assets/spotit/splash-mark.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "@react-native-seoul/kakao-login",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "nativeMaps": {
        "androidConfigured": false
      },
      "router": {},
      "eas": {
        "projectId": "39df2628-3101-4b34-9404-5c3592ec9c89"
      }
    }
  }
}
