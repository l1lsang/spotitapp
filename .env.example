# Same Firebase web client settings as the source app (public configuration).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_KAKAO_PROVIDER_ID=oidc.kakao
EXPO_PUBLIC_WEB_URL=https://www.pinori.kr
# Native provider registrations; web JavaScript map keys do not replace these.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# Apple Android login: registered Services ID, also configured in Firebase Auth.
EXPO_PUBLIC_APPLE_SERVICE_ID=
# Optional: defaults to https://<FIREBASE_AUTH_DOMAIN>/__/auth/handler.
# Must exactly match an HTTPS Return URL registered for the Apple Services ID.
EXPO_PUBLIC_APPLE_REDIRECT_URI=
# Web maps and search. Restrict the browser key to your website and local preview origins.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Native place search also needs backend secrets; see docs/native-map-setup.md.
# GOOGLE_PLACES_SERVER_API_KEY belongs in
# Firebase Secret Manager, never in EXPO_PUBLIC_ variables.
# Push: configure EAS credentials and deploy backend native push support first.
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_INFO_PLIST=
# Optional local emulators. Physical devices need your computer's LAN address.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
