{
  "name": "spotit",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-media-library"
        ],
        "buildFromSource": [
          "expo-image-picker"
        ]
      }
    }
  },
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-media-library": "~57.0.5",
    "expo-modules-core": "~57.0.18",
    "expo-notifications": "~57.0.18",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test:push": "node --test backend/functions/nativePush.test.cjs",
    "test:places": "node --test backend/functions/placeSearch.test.cjs",
    "test:kakao": "node --test backend/functions/kakaoAuth.test.cjs",
    "test:kakao:client": "node --experimental-vm-modules --test tests/kakaoLogin.test.mjs",
    "test:apple": "node --experimental-vm-modules --test tests/appleLogin.test.mjs",
    "test:kakao:integration": "node scripts/test-kakao-auth.mjs",
    "test:integration": "node scripts/test-native-emulators.mjs",
    "licenses:generate": "node scripts/generate-open-source-licenses.mjs",
    "build": "npm run typecheck && npm run licenses:check && expo export --platform all",
    "licenses:check": "node scripts/generate-open-source-licenses.mjs --check",
    "dev-client": "expo start --dev-client",
    "release:publish": "node --experimental-strip-types scripts/publish-app-release.mjs",
    "test": "node --import ./tests/register-types.mjs --test tests/signupRequirements.test.mjs tests/maps.test.mjs tests/chatReadReceipts.test.mjs tests/chatReactions.test.mjs tests/chatPinShare.test.mjs tests/appRelease.test.mjs tests/publishAppRelease.test.mjs tests/photoMetadata.test.mjs tests/pinThemes.test.mjs tests/mapFeedChat.test.mjs tests/userSearch.test.mjs tests/postSearch.test.mjs tests/contentFilter.test.mjs",
    "go": "expo start --go"
  },
  "private": true
}
